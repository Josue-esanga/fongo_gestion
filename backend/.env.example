# ---------------------------------------------------------------------------
# Configuration du backend FongoGestion — copier ce fichier vers `.env` :
#     cp .env.example .env
#
# `.env` est ignoré par git : les secrets ne quittent jamais ta machine.
# `settings.py` le charge automatiquement au démarrage.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# Deux modes possibles ; DATABASE_URL prime s'il est défini.
#
# 1) Une seule URL (format Supabase) — Dashboard → Connect → Session pooler :
#    DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
#    ⚠ Encodage obligatoire des caractères réservés du mot de passe :
#      `@` → `%40`  (ex. josue@esanga1 devient josue%40esanga1),
#      `:` → `%3A`, `/` → `%2F`, `#` → `%23`, `?` → `%3F`.
#      Un `@` non encodé casse l'hôte → « connexion refusée ».
DATABASE_URL=

# 2) Variables séparées (utilisé en local par dev.sh) :
# DB_NAME=Fongo_gestion_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Options avancées :
# DB_SSLMODE=                 # defaut : `require` dès que DB_HOST n'est pas local
# DB_CONN_MAX_AGE=0           # durée (s) d'une connexion réutilisée ; 0 = serverless

# --- Django ----------------------------------------------------------------
# Local : True par défaut. Sur Vercel : mettre False.
DEBUG=True

# Obligatoire en production — génération :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

# Hôtes autorisés (virgules) ; sur Vercel, `.vercel.app` est ajouté automatiquement.
# ALLOWED_HOSTS=localhost,127.0.0.1,api.mon-app.vercel.app

# Origines frontend autorisées (CORS / CSRF).
# CORS_ALLOWED_ORIGINS=https://mon-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://mon-app.vercel.app

# Sécurité (HTTPS) — HSTS à n'activer qu'après vérification du domaine :
# SECURE_HSTS_SECONDS=0
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- Supabase Storage (fichiers téléversés) --------------------------------
# Indispensable en production : le disque de Vercel est en lecture seule.
# Étapes : Storage → New bucket (« fongogestion », PUBLIC) puis
# Storage → Settings → S3 compatible API (copier endpoint, région, clés).
# Les cinq premières variables sont TOUS requises : si l'une manque, le
# stockage reste sur disque local (fichiers introuvables en production).
#   Endpoint   : https://<ref>.supabase.co/storage/v1/s3
#   Région     : valeur affichée dans Storage → Settings
# Envoi des fichiers existants : python scripts/upload_media.py
# SUPABASE_S3_ENDPOINT=
# SUPABASE_S3_BUCKET=
# SUPABASE_S3_REGION=
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_PUBLIC_DOMAIN=        # optionnel : déduit de l'endpoint
#                                    # (<ref>.supabase.co/storage/v1/object/public/<bucket>)
