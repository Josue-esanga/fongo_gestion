# URL de base de l'API Django REST.
# En développement, laisser vide pour utiliser le proxy Vite (/api -> 127.0.0.1:8000).
# En production, indiquer l'URL complète du backend, ex. https://api.mondomaine.com/api
VITE_API_URL=

# Numéro Lumicash du club (Burundi) affiché dans la carte « Payer par
# Lumicash » du stagiaire. Non défini = valeur par défaut du code.
VITE_LUMICASH_NUMBER=
