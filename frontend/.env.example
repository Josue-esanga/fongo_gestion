# URL de base de l'API Django REST.
# En développement, laisser vide pour utiliser le proxy Vite (/api -> backend configure ci-dessous).
# En production, indiquer l'URL complète du backend, ex. https://api.mondomaine.com/api
VITE_API_URL=

# URL du backend Django pour le proxy Vite en developpement.
# Change le port ici si ton backend tourne sur un autre port (ex: 8080).
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_MEDIA_URL=http://127.0.0.1:8000
VITE_STATIC_URL=http://127.0.0.1:8000

# Numéro Lumicash du club (Burundi) affiché dans la carte « Payer par
# Lumicash » du stagiaire. Non defini = valeur par defaut du code.
VITE_LUMICASH_NUMBER=
